# Olleik Foods — environment variables
# Copy to .env.local for local dev. Set the production values in Vercel.

# Supabase (provisioned in Phase 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (provisioned in Phase 2; used for invoicing / card payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Admin access control — comma-separated emails allowed into /admin.
# These must be Supabase Auth users (create them in the Supabase dashboard).
# Leave empty to allow ANY authenticated user; set this BEFORE launching the
# customer portal so customer accounts can't reach /admin.
ADMIN_EMAILS=
