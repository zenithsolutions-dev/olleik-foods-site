# Olleik Foods — environment variables
# Copy to .env.local for local dev. Set the production values in Vercel.

# Supabase (provisioned in Phase 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (provisioned in Phase 2; used for invoicing / card payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Admin access control — comma-separated emails allowed into /admin.
# These must be Supabase Auth users (create them in the Supabase dashboard).
# Leave empty to allow ANY authenticated user; set this BEFORE launching the
# customer portal so customer accounts can't reach /admin.
ADMIN_EMAILS=

# Owners — the admins allowed to see cost, profit and margins. Comma-separated subset of ADMIN_EMAILS.
# Leave EMPTY and every admin is an owner. Set it as soon as a second, non-owner admin is added.
OWNER_EMAILS=

# Email (new-order, low-stock and daily-report emails). The sender name/address and the recipients are set
# in the admin under Settings; these are only the connection to the email service (Resend request shape).
EMAIL_API_KEY=
# Leave empty for the real service. Local development points this at a test inbox.
EMAIL_API_URL=
# Public address of the site, used for the links inside emails (no trailing slash).
NEXT_PUBLIC_SITE_URL=
# Secret the scheduler sends to /api/cron/daily-report as "Authorization: Bearer <secret>".
CRON_SECRET=

# Business time zone (IANA name, e.g. America/Toronto). Used for day boundaries and dates on documents.
NEXT_PUBLIC_BUSINESS_TIME_ZONE=
